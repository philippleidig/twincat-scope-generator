<?xml version="1.0"?>
<!-- Synthetic demo System Manager project for the TwinCAT Scope Generator: an NC task with two stepper axes
     and an EtherCAT master (EK1100 coupler, digital I/O, analog input, two EL7041 stepper terminals) whose
     process image serves its symbols over ADS. The terminal icons
     are the bitmaps TwinCAT stores in such projects (EL1008 uses one of its built-in images, id 7). Structure follows .tsproj files saved by TwinCAT XAE;
     the PLC symbols of the same machine are in DemoMachine.tmc. -->
<TcSmProject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.beckhoff.com/schemas/2012/07/TcSmProject" TcSmVersion="1.0" TcVersion="3.1.4026.17">
	<ImageDatas>
		<ImageData Id="1000"></ImageData>
		<ImageData Id="1001"></ImageData>
		<ImageData Id="1002"></ImageData>
		<ImageData Id="1003"></ImageData>
	</ImageDatas>
	<Project ProjectGUID="{3B0A7E52-6C1D-4F0E-9D7A-2E5C8B41F6A3}" Target64Bit="true">
		<System>
			<Tasks>
				<Task Id="2" Priority="20" CycleTime="100000" AmsPort="350" AdtTasks="true"><Name>PlcTask</Name></Task>
			</Tasks>
		</System>
		<Motion>
			<NC>
				<SafTask Priority="4" CycleTime="20000" AmsPort="501" IoAtBegin="true">
					<Name>NC-Task 1 SAF</Name>
					<Image Id="3" AddrType="1" ImageType="1"><Name>Image</Name></Image>
				</SafTask>
				<SvbTask Priority="9" CycleTime="100000" AmsPort="511"><Name>NC-Task 1 SVB</Name></SvbTask>
				<Axis Id="1" CreateSymbols="true" AxisType="1">
					<Name>Gantry X</Name>
					<Encoder Name="Enc" EncType="9"/>
					<Drive Name="Drive" DrvType="24"/>
					<Controller Name="Ctrl" CtrType="1"/>
				</Axis>
				<Axis Id="2" CreateSymbols="true" AxisType="1">
					<Name>Gantry Y</Name>
					<Encoder Name="Enc" EncType="9"/>
					<Drive Name="Drive" DrvType="24"/>
					<Controller Name="Ctrl" CtrType="1"/>
				</Axis>
			</NC>
		</Motion>
		<Io>
			<Device Id="1" DevType="111" AmsPort="28673" AmsNetId="5.10.20.30.2.1" RemoteName="Device 1 (EtherCAT)">
				<Name>Device 1 (EtherCAT)</Name>
				<Image Id="1" ImageFlags="#x00000030" AddrType="9" ImageType="3"><Name>Image</Name></Image>
				<Box Id="1" BoxType="9099">
					<Name>Term 1 (EK1100)</Name>
					<ImageId>1000</ImageId>
					<EtherCAT VendorId="#x00000002" Type="EK1100 EtherCAT Coupler (2A E-Bus)" Desc="EK1100"/>
					<Box Id="2" BoxType="9099">
						<Name>Term 2 (EL1008)</Name>
						<ImageId>7</ImageId>
						<EtherCAT VendorId="#x00000002" Type="EL1008 8Ch. Dig. Input 24V, 3ms" Desc="EL1008">
							<Pdo Name="Channel 1" Index="#x1a00" Flags="#x0011" SyncMan="0">
								<Entry Name="Input" Index="#x6000" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 2" Index="#x1a01" Flags="#x0011" SyncMan="0">
								<Entry Name="Input" Index="#x6100" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 3" Index="#x1a02" Flags="#x0011" SyncMan="0">
								<Entry Name="Input" Index="#x6200" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 4" Index="#x1a03" Flags="#x0011" SyncMan="0">
								<Entry Name="Input" Index="#x6300" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 5" Index="#x1a04" Flags="#x0011" SyncMan="0">
								<Entry Name="Input" Index="#x6400" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 6" Index="#x1a05" Flags="#x0011" SyncMan="0">
								<Entry Name="Input" Index="#x6500" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 7" Index="#x1a06" Flags="#x0011" SyncMan="0">
								<Entry Name="Input" Index="#x6600" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 8" Index="#x1a07" Flags="#x0011" SyncMan="0">
								<Entry Name="Input" Index="#x6700" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
						</EtherCAT>
					</Box>
					<Box Id="3" BoxType="9099">
						<Name>Term 3 (EL2008)</Name>
						<ImageId>1001</ImageId>
						<EtherCAT VendorId="#x00000002" Type="EL2008 8Ch. Dig. Output 24V, 0.5A" Desc="EL2008">
							<Pdo Name="Channel 1" Index="#x1600" InOut="1" Flags="#x0011" SyncMan="0">
								<Entry Name="Output" Index="#x7000" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 2" Index="#x1601" InOut="1" Flags="#x0011" SyncMan="0">
								<Entry Name="Output" Index="#x7100" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 3" Index="#x1602" InOut="1" Flags="#x0011" SyncMan="0">
								<Entry Name="Output" Index="#x7200" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 4" Index="#x1603" InOut="1" Flags="#x0011" SyncMan="0">
								<Entry Name="Output" Index="#x7300" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 5" Index="#x1604" InOut="1" Flags="#x0011" SyncMan="0">
								<Entry Name="Output" Index="#x7400" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 6" Index="#x1605" InOut="1" Flags="#x0011" SyncMan="0">
								<Entry Name="Output" Index="#x7500" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 7" Index="#x1606" InOut="1" Flags="#x0011" SyncMan="0">
								<Entry Name="Output" Index="#x7600" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
							<Pdo Name="Channel 8" Index="#x1607" InOut="1" Flags="#x0011" SyncMan="0">
								<Entry Name="Output" Index="#x7700" Sub="#x01"><Type>BIT</Type></Entry>
							</Pdo>
						</EtherCAT>
					</Box>
					<Box Id="4" BoxType="9099">
						<Name>Term 4 (EL3102)</Name>
						<ImageId>1002</ImageId>
						<EtherCAT VendorId="#x00000002" Type="EL3102 2Ch. Ana. Input +/-10V, Diff." Desc="EL3102">
							<Pdo Name="AI Standard Channel 1" Index="#x1a00" Flags="#x0010" SyncMan="3">
								<Entry Name="Status__Underrange" Index="#x6000" Sub="#x01"><Type>BIT</Type></Entry>
								<Entry Name="Status__Overrange" Index="#x6000" Sub="#x02"><Type>BIT</Type></Entry>
								<Entry Name="Status__Limit 1" Index="#x6000" Sub="#x03"><Type>BIT2</Type></Entry>
								<Entry Name="Status__Limit 2" Index="#x6000" Sub="#x05"><Type>BIT2</Type></Entry>
								<Entry Name="Status__Error" Index="#x6000" Sub="#x07"><Type>BIT</Type></Entry>
								<Entry Name="Status__" Index="#x6000" Sub="#x08"><Type>ARRAY [0..6] OF BIT</Type></Entry>
								<Entry Name="Status__TxPDO State" Index="#x6000" Sub="#x0f"><Type>BIT</Type></Entry>
								<Entry Name="Status__TxPDO Toggle" Index="#x6000" Sub="#x10"><Type>BIT</Type></Entry>
								<Entry Name="Value" Index="#x6000" Sub="#x11"><Type>INT</Type></Entry>
							</Pdo>
							<Pdo Name="AI Standard Channel 2" Index="#x1a02" Flags="#x0010" SyncMan="3">
								<Entry Name="Status__Underrange" Index="#x6010" Sub="#x01"><Type>BIT</Type></Entry>
								<Entry Name="Status__Overrange" Index="#x6010" Sub="#x02"><Type>BIT</Type></Entry>
								<Entry Name="Status__Limit 1" Index="#x6010" Sub="#x03"><Type>BIT2</Type></Entry>
								<Entry Name="Status__Limit 2" Index="#x6010" Sub="#x05"><Type>BIT2</Type></Entry>
								<Entry Name="Status__Error" Index="#x6010" Sub="#x07"><Type>BIT</Type></Entry>
								<Entry Name="Status__" Index="#x6010" Sub="#x08"><Type>ARRAY [0..6] OF BIT</Type></Entry>
								<Entry Name="Status__TxPDO State" Index="#x6010" Sub="#x0f"><Type>BIT</Type></Entry>
								<Entry Name="Status__TxPDO Toggle" Index="#x6010" Sub="#x10"><Type>BIT</Type></Entry>
								<Entry Name="Value" Index="#x6010" Sub="#x11"><Type>INT</Type></Entry>
							</Pdo>
						</EtherCAT>
					</Box>
					<Box Id="5" BoxType="9099">
						<Name>Term 5 (EL7041)</Name>
						<ImageId>1003</ImageId>
						<EtherCAT VendorId="#x00000002" Type="EL7041 1Ch. Stepper motor output stage (50V, 5A)" Desc="EL7041">
							<Pdo Name="ENC Status compact" Index="#x1a00" Flags="#x0010" SyncMan="3">
								<Entry Name="Status__Latch C valid" Index="#x6000" Sub="#x01"><Type>BIT</Type></Entry>
								<Entry Name="Status__Latch extern valid" Index="#x6000" Sub="#x02"><Type>BIT</Type></Entry>
								<Entry Name="Status__Set counter done" Index="#x6000" Sub="#x03"><Type>BIT</Type></Entry>
								<Entry Name="Status__" Index="#x6000" Sub="#x04"><Type>ARRAY [0..9] OF BIT</Type></Entry>
								<Entry Name="Status__TxPDO Toggle" Index="#x6000" Sub="#x10"><Type>BIT</Type></Entry>
								<Entry Name="Counter value" Index="#x6000" Sub="#x11"><Type>UINT</Type></Entry>
								<Entry Name="Latch value" Index="#x6000" Sub="#x12"><Type>UINT</Type></Entry>
							</Pdo>
							<Pdo Name="ENC Status" Index="#x1a01" Flags="#x0010">
								<Entry Name="Status__Latch C valid" Index="#x6000" Sub="#x01"><Type>BIT</Type></Entry>
								<Entry Name="Counter value" Index="#x6000" Sub="#x11"><Type>UDINT</Type></Entry>
								<Entry Name="Latch value" Index="#x6000" Sub="#x12"><Type>UDINT</Type></Entry>
							</Pdo>
							<Pdo Name="STM Status" Index="#x1a03" Flags="#x0010" SyncMan="3">
								<Entry Name="Status__Ready to enable" Index="#x6010" Sub="#x01"><Type>BIT</Type></Entry>
								<Entry Name="Status__Ready" Index="#x6010" Sub="#x02"><Type>BIT</Type></Entry>
								<Entry Name="Status__Warning" Index="#x6010" Sub="#x03"><Type>BIT</Type></Entry>
								<Entry Name="Status__Error" Index="#x6010" Sub="#x04"><Type>BIT</Type></Entry>
								<Entry Name="Status__Moving positive" Index="#x6010" Sub="#x05"><Type>BIT</Type></Entry>
								<Entry Name="Status__Moving negative" Index="#x6010" Sub="#x06"><Type>BIT</Type></Entry>
								<Entry Name="Status__Torque reduced" Index="#x6010" Sub="#x07"><Type>BIT</Type></Entry>
								<Entry Name="Status__" Index="#x6010" Sub="#x08"><Type>ARRAY [0..8] OF BIT</Type></Entry>
							</Pdo>
							<Pdo Name="ENC Control compact" Index="#x1600" InOut="1" Flags="#x0010" SyncMan="2">
								<Entry Name="Control__" Index="#x7000" Sub="#x01"><Type>ARRAY [0..15] OF BIT</Type></Entry>
								<Entry Name="Set counter value" Index="#x7000" Sub="#x11"><Type>UINT</Type></Entry>
