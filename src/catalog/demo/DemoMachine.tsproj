						<ImageId>1003</ImageId>
						<EtherCAT VendorId="#x00000002" Type="EL7041 1Ch. Stepper motor output stage (50V, 5A)" Desc="EL7041">
							<Pdo Name="ENC Status compact" Index="#x1a00" Flags="#x0010" SyncMan="3">
