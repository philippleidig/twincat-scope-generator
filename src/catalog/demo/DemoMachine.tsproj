								<Entry Name="Control__Enable" Index="#x7010" Sub="#x01"><Type>BIT</Type></Entry>
								<Entry Name="Control__Reset" Index="#x7010" Sub="#x02"><Type>BIT</Type></Entry>
								<Entry Name="Control__Reduce torque" Index="#x7010" Sub="#x03"><Type>BIT</Type></Entry>
								<Entry Name="Control__" Index="#x7010" Sub="#x04"><Type>ARRAY [0..12] OF BIT</Type></Entry>
							</Pdo>
							<Pdo Name="STM Velocity" Index="#x1604" InOut="1" Flags="#x0010" SyncMan="2">
								<Entry Name="Velocity" Index="#x7010" Sub="#x21"><Type>INT</Type></Entry>
							</Pdo>
						</EtherCAT>
